# Marketplace database (keep the /MarketPlace database name)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/MarketPlace?retryWrites=true&w=majority

# Shared pharmacy catalog database on the same MongoDB cluster
PHARMACY_DB_NAME=Pharmacy

# Generate a long, random secret and keep it private
JWT_SECRET=replace-with-a-long-random-secret

# Google Identity Services Web client ID (public identifier, no client secret needed)
GOOGLE_CLIENT_ID=123456789-example.apps.googleusercontent.com

# Resend transactional email (verify dawaconnect.store in Resend first)
RESEND_API_KEY=re_replace-with-your-resend-api-key
RESEND_FROM_EMAIL="DawaConnect <noreply@dawaconnect.store>"
# Signing secret from the Resend webhook configured for /api/webhooks/resend
RESEND_WEBHOOK_SECRET=whsec_replace-with-your-resend-webhook-secret
# Generate an independent random value of at least 32 characters; never reuse JWT_SECRET
EMAIL_OTP_PEPPER=replace-with-an-independent-long-random-secret
# Documentation/configuration marker. Marketplace signup codes are intentionally fixed at 5 minutes.
EMAIL_OTP_EXPIRY_MINUTES=5

# Live order chat. CHAT_TOKEN_SECRET must match the shared Express chat service.
CHAT_TOKEN_SECRET=4UC9GrVwtFgCke6t8yhOlRu5GOEfE1Do3z8mrQj-zhKDTuVUwQUsO_cJ_-8k81bb
# Public HTTPS/WSS origin of the Express + Socket.IO service (no trailing slash).
NEXT_PUBLIC_CHAT_SERVICE_URL=http://localhost:5000

# Groq API access
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_CHAT_MODELS=openai/gpt-oss-20b,qwen/qwen3.6-27b,openai/gpt-oss-120b,qwen/qwen3.8-27b

# Daily AI limits reset according to this timezone
AI_USAGE_TIMEZONE=Asia/Karachi
# Private key for healthcare places, area search and directions (set in .env.local).
# The default OpenFreeMap basemap does not need a key.
GEOAPIFY_API_KEY=
