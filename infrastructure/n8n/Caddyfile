{$N8N_DOMAIN} {
    encode zstd gzip

    reverse_proxy n8n:5678

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    log {
        output stdout
        format console
    }
}

