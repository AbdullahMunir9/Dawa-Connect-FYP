# Public n8n hostname. Create an A record pointing this name to the Oracle reserved public IP.
N8N_DOMAIN=n8n.dawaconnect.store

# Versions intentionally pinned for reproducible deployment.
# n8n 3.0 has breaking changes; validate its migration separately before upgrading.
N8N_VERSION=2.45.4
POSTGRES_VERSION=17.11-alpine
CADDY_VERSION=2.11.7-alpine

# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-a-persistent-64-character-hex-key

POSTGRES_DB=n8n
POSTGRES_USER=n8n
# Generate with: openssl rand -base64 36
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password

GENERIC_TIMEZONE=Asia/Karachi

