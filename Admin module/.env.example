# MongoDB connection strings (MarketPlace and Pharmacy logical databases)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/MarketPlace?retryWrites=true&w=majority
PHARMACY_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/Pharmacy?retryWrites=true&w=majority

# Express API runtime
NODE_ENV=development
PORT=5000

# Admin API auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed browser origins for the admin UI
CORS_ORIGIN=http://localhost:5173

# Shared live-chat signing secret. Use the same value in the Marketplace server.
CHAT_TOKEN_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
# Exact browser origins allowed to connect to Socket.IO (comma-separated in production).
CHAT_CORS_ORIGINS=http://localhost:3000

# Optional: override the products collection name in the Pharmacy database
PHARMACY_PRODUCTS_COLLECTION=products

# Optional privacy thresholds for city delivery-opportunity analytics
ANALYTICS_CITY_GRID_KM=2
ANALYTICS_CITY_MIN_ZONE_ORDERS=5
ANALYTICS_CITY_MIN_ZONE_PHARMACIES=2

# Server-only monthly analytics narrative provider. Never put this key in the Electron app.
ANALYTICS_AI_PROVIDER=groq
ANALYTICS_AI_API_KEY=replace-with-a-dedicated-groq-api-key
ANALYTICS_AI_MODEL=openai/gpt-oss-20b
ANALYTICS_AI_TIMEOUT_MS=25000
ANALYTICS_AI_REGENERATION_COOLDOWN_SECONDS=300

# Pharmacy desktop API (secrets stay on this server, never in the .exe)
GEOAPIFY_API_KEY=replace-with-your-geoapify-api-key
RESEND_API_KEY=re_replace-with-your-resend-api-key
RESEND_FROM_EMAIL="DawaConnect <noreply@dawaconnect.store>"
PHARMACY_OTP_PEPPER=replace-with-an-independent-random-secret-at-least-32-characters

# Cloudinary (server-only pharmacy inside/outside photos)
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-your-cloudinary-api-secret

# Vite browser configuration. This value is public in the frontend bundle.
VITE_API_BASE_URL=http://localhost:5000/api
