# MongoDB connection strings (MarketPlace and Pharmacy logical databases)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/MarketPlace?retryWrites=true&w=majority
PHARMACY_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/Pharmacy?retryWrites=true&w=majority

# Express API runtime
NODE_ENV=development
PORT=5000

# Admin API auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed browser origins for the admin UI
CORS_ORIGIN=http://localhost:5173

# Optional: override the products collection name in the Pharmacy database
PHARMACY_PRODUCTS_COLLECTION=products

# Vite browser configuration. This value is public in the frontend bundle.
VITE_API_BASE_URL=http://localhost:5000/api
