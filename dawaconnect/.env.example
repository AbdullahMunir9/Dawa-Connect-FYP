MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/Pharmacy?appName=<app-name>
PHARMACY_DB_NAME=Pharmacy
MARKETPLACE_DB_NAME=MarketPlace

# Optional development renderer URL; electron-vite normally supplies this.
# ELECTRON_RENDERER_URL=http://localhost:5173

# Password-reset email. Prefer a transactional provider account in production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-app-password
SMTP_FROM=your-email@gmail.com
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# Required for pharmacy registration address search and confirmed-pin address lookup.
# Get a free key from https://myprojects.geoapify.com/ and restart the desktop app.
GEOAPIFY_API_KEY=
